{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "worker": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/worker.ts",
    "bench:providers": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/provider-bench.ts",
    "test": "tsx --conditions=react-server --env-file-if-exists=.env.local --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "names:build": "tsx scripts/names/build.ts",
    "names:import": "tsx --env-file=.env.local scripts/names/import.ts",
    "admin:create-user": "tsx --env-file=.env.local scripts/admin/create-user.ts",
    "admin:seed-queue": "tsx --env-file=.env.local scripts/admin/seed-review-queue.ts",
    "test:render": "tsx --test --test-concurrency=1 \"src/**/*.render-test.ts\""
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "motion": "^13.4.1",
    "next": "16.3.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "puppeteer-core": "^25.11.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
