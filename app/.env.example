# Skopírujte do .env.local a upravte.
DATABASE_URL=postgres://localhost:5432/knizka_dev

# Lokálne úložisko súborov (fotky, ilustrácie) – mimo public/, fotky nesmú byť verejné.
STORAGE_DIR=./.storage

# AI poskytovatelia – zatiaľ \"mock\"; skutočné kľúče dodá firma pri finálnom produkte.
AI_IMAGE_PROVIDER=mock
AI_TEXT_PROVIDER=mock

# Podpis cookie prístupu k projektu (aspoň 32 znakov). V produkcii povinné.
SESSION_SECRET=
# Umelé oneskorenie mock generovania strán (ms), aby bol vidieť priebeh kroku 7.
MOCK_AI_DELAY_MS=700

# Renderer knihy (balík C)
# Tajomstvo pre podpísané krátkodobé odkazy na obrázky náhľadu (S5) – v produkcii povinné.
MEDIA_URL_SECRET=
# Chrome/Chromium pre PDF (predvolene systémový Chrome na macOS, /usr/bin/chromium na Linuxe).
CHROME_PATH=
# Verejná adresa aplikácie – QR kód v tiráži (osobná stránka knihy, balík D).
APP_URL=http://localhost:3000
